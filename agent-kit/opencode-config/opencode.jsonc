{
    "$schema":  "https://opencode.ai/config.json",
    "plugin":  [
                   "superpowers@git+https://github.com/obra/superpowers.git",
                   "oh-my-openagent@latest"
               ],
    "mcp":  {
                "obsidian-memory":  {
                                        "type":  "local",
                                        "command":  [
                                                        "node",
                                                        "C:/Users/moaz7/obsidian-memory-layer-mcp/dist/index.js",
                                                        "C:/Users/moaz7/ObsidianVault"
                                                    ],
                                        "enabled":  true
                                    },
                "sequential-thinking":  {
                                            "type":  "local",
                                            "command":  [
                                                            "npx",
                                                            "-y",
                                                            "@modelcontextprotocol/server-sequential-thinking"
                                                        ],
                                            "enabled":  true
                                        },
                "duckduckgo":  {
                                   "type":  "local",
                                   "command":  [
                                                   "npx",
                                                   "-y",
                                                   "@ericthered926/duckduckgo-mcp-server"
                                               ],
                                   "enabled":  true
                               },
                "filesystem":  {
                                   "type":  "local",
                                   "command":  [
                                                   "npx",
                                                   "-y",
                                                   "@modelcontextprotocol/server-filesystem",
                                                   "C:\\Users\\moaz7"
                                               ],
                                   "enabled":  true
                               },
                "github":  {
                               "type":  "local",
                               "command":  [
                                               "npx",
                                               "-y",
                                               "@modelcontextprotocol/server-github"
                                           ],
                               "enabled":  true,
                               "environment":  {
                                                   "GITHUB_TOKEN":  "{env:GITHUB_TOKEN}"
                                               }
                           },
                "playwright":  {
                                   "type":  "local",
                                   "command":  [
                                                   "npx",
                                                   "-y",
                                                   "@playwright/mcp"
                                               ],
                                   "enabled":  true
                               },
                "sqlite":  {
                               "type":  "local",
                               "command":  [
                                               "npx",
                                               "-y",
                                               "@mokei/mcp-sqlite"
                                           ],
                               "enabled":  true
                           },
                "winget-mcp":  {
                                   "type":  "local",
                                   "command":  [
                                                   "C:\\Users\\moaz7\\AppData\\Local\\Microsoft\\WindowsApps\\Microsoft.DesktopAppInstaller_8wekyb3d8bbwe\\WindowsPackageManagerMCPServer.exe"
                                               ],
                                   "enabled":  true
                               },
                "pdf":  {
                            "type":  "local",
                            "command":  [
                                            "npx",
                                            "-y",
                                            "@modelcontextprotocol/server-pdf"
                                        ],
                            "enabled":  false
                        },
                "supabase":  {
                                 "type":  "remote",
                                 "url":  "https://mcp.supabase.com/mcp?project_ref=vjhzbqtoktktrjevcodq\u0026features=docs%2Caccount%2Cdatabase%2Cdebugging%2Cdevelopment%2Cfunctions%2Cbranching",
                                 "enabled":  true
                             },
                "cloudflare":  {
                                   "type":  "remote",
                                   "url":  "https://mcp.cloudflare.com/mcp",
                                   "enabled":  true,
                                   "oauth":  {

                                             }
                               },
                "cloudflare-docs":  {
                                        "type":  "remote",
                                        "url":  "https://docs.mcp.cloudflare.com/mcp",
                                        "enabled":  true
                                    },
                "cloudflare-bindings":  {
                                            "type":  "remote",
                                            "url":  "https://bindings.mcp.cloudflare.com/mcp",
                                            "enabled":  true,
                                            "oauth":  {

                                                      }
                                        },
                "cloudflare-builds":  {
                                          "type":  "remote",
                                          "url":  "https://builds.mcp.cloudflare.com/mcp",
                                          "enabled":  true,
                                          "oauth":  {

                                                    }
                                      },
                "cloudflare-observability":  {
                                                 "type":  "remote",
                                                 "url":  "https://observability.mcp.cloudflare.com/mcp",
                                                 "enabled":  true,
                                                 "oauth":  {

                                                           }
                                             }
            },
    "tools":  {
                  "obsidian-memory_*":  true,
                  "sequential-thinking_*":  false,
                  "duckduckgo_*":  false,
                  "filesystem_*":  false,
                  "github_*":  false,
                  "playwright_*":  false,
                  "sqlite_*":  false,
                  "winget-mcp_*":  false,
                  "supabase_*":  false,
                  "cloudflare_*":  false,
                  "cloudflare-docs_*":  false,
                  "cloudflare-bindings_*":  false,
                  "cloudflare-builds_*":  false,
                  "cloudflare-observability_*":  false
              },
    "agent":  {
                  "sisyphus":  {
                                   "permission":  {
                                                      "duckduckgo_*":  "allow",
                                                      "obsidian-memory_*":  "allow",
                                                      "filesystem_*":  "allow",
                                                      "sequential-thinking_*":  "allow"
                                                  }
                               },
                  "explore":  {
                                  "permission":  {
                                                     "github_*":  "allow",
                                                     "duckduckgo_*":  "allow",
                                                     "filesystem_*":  "allow"
                                                 }
                              },
                  "auto-build":  {
                                     "permission":  {
                                                        "github_*":  "allow",
                                                        "playwright_*":  "allow",
                                                        "filesystem_*":  "allow"
                                                    }
                                 },
                  "deep-debug":  {
                                     "permission":  {
                                                        "sequential-thinking_*":  "allow"
                                                    }
                                 },
                  "code-search":  {
                                      "permission":  {
                                                         "filesystem_*":  "allow",
                                                         "duckduckgo_*":  "allow"
                                                     }
                                  },
                  "sisyphus-junior":  {
                                          "permission":  {
                                                             "filesystem_*":  "allow",
                                                             "duckduckgo_*":  "allow"
                                                         }
                                      },
                  "strategy-plan":  {
                                        "permission":  {
                                                           "duckduckgo_*":  "allow"
                                                       }
                                    },
                  "build":  {
                                "permission":  {
                                                   "github_*":  "allow",
                                                   "playwright_*":  "allow",
                                                   "filesystem_*":  "allow"
                                               }
                            },
                  "plan":  {
                               "permission":  {
                                                  "duckduckgo_*":  "allow"
                                              }
                           },
                  "planner":  {
                                  "prompt":  "C:/Users/moaz7/.config/opencode/agents/planner.md",
