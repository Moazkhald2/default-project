                                                     "glob":  "allow",
                                                     "read":  "allow",
                                                     "bash":  "allow",
                                                     "grep":  "allow",
                                                     "edit":  "deny",
                                                     "write":  "deny"
                                                 }
                              },
                  "reviewer":  {
