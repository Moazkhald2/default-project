# Production API secrets (via wrangler in prod, .env locally — never commit .env)
# JWT_SECRET must be >=32 chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-32-plus-char-secret-for-dev-only-1234567890
# Local dev SQLite (default when unset: file:./apps/api/dev.db)
# TURSO_DATABASE_URL=file:./apps/api/dev.db
# Prod Turso:
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-turso-token
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# REPO_ROOT override (optional, defaults to repo root auto-detected)
# REPO_ROOT=C:\path\to\repo

# Free Claude Code — https://github.com/Alishahryar1/free-claude-code
# Copy to .env (gitignored) and fill chosen provider. FCC reads via Admin UI or env.
# See .opencode/skills/free-claude-code/SKILL.md for 49-provider catalog.

# Recommended free tier
NVIDIA_NIM_API_KEY=nvapi-...

# Alternatives — uncomment one
# OPENROUTER_API_KEY=sk-or-...
# GROQ_API_KEY=gsk_...
# DEEPSEEK_API_KEY=sk-...
# GITHUB_MODELS_TOKEN=ghp_...

# Local — no key, set base URL
# LM_STUDIO_BASE_URL=http://localhost:1234/v1
# OLLAMA_BASE_URL=http://localhost:11434
# LLAMACPP_BASE_URL=http://localhost:8080/v1

# FCC proxy (Admin UI defaults)
# ANTHROPIC_BASE_URL=http://localhost:8082
# ANTHROPIC_AUTH_TOKEN=freecc

# Model routing (Admin UI MODEL dropdown)
# MODEL=nvidia_nim/nvidia/nemotron-3-super-120b-a12b
# Fallback example: MODEL_FABLE=..., MODEL_OPUS=nvidia_nim/nvidia/nemotron-3-super-120b-a12b
